# 앱 버전은 VERSION 파일을 기준으로 합니다.
APP_VERSION=0.1

# 백엔드 — 기존 kiwoom_autotrading(8000/3000)과 동시에 켜도 충돌하지 않게 8010/3010
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010

# 키움 — 운영/모의 키는 서로 다릅니다. 이 파일을 복사해 .env로 쓰세요.
KIWOOM_MODE=real
APP_KEY=
APP_SECRET=
APP_KEY_MOCK=
APP_SECRET_MOCK=

# 0.1 — 시세·호가·차트·예수금·잔고는 키움. 주문은 KIWOOM_ORDERS_ENABLED=true 일 때만.
# 자동매매 전략은 이 프로젝트에 없습니다.
KIWOOM_ENABLED=false
KIWOOM_ORDERS_ENABLED=false
